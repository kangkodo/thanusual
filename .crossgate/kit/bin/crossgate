#!/usr/bin/env python3
"""Crossgate — AI 교차검수 파이프라인 CLI. 표준 라이브러리만 사용한다 (Python 3.9+).

하위 명령:
  init-run SLUG [--route R]      ai-log 실행 폴더를 만들고 현재 실행으로 지정 (R: light|standard|full, 기본 full)
  codex ROLE --prompt-file F     Codex 역할 호출 (검수 역할은 항상 읽기 전용). --effort 로 추론 강도 지정
  claude ROLE --prompt-file F    Claude 검수 호출 (읽기 도구만, MCP 없음, 사용량 기록). --effort 로 추론 강도 지정
  route R                        현재 실행의 등급을 올린다 (light → standard → full, 낮추기는 새 실행으로)
  verify                         설치된 킷 복사본이 봉인 그대로인지 확인
  gate [--protect-since REF]     고정층 검사 + 보호 경로 변경 검사
  verdict --stage S --verdict V  판정 한 줄 기록 + timeline.md 재생성
  status                         단계별 최신 판정과 조정 필요 여부
  merge-check --base REF         병합 위임 조건 판정 (CI 필수 검사로도 사용)
  deploy [--yes]                 배포 미리보기, --yes 면 실행 (사용자 지시가 있을 때만)
  clean-raw [--days N]           기한이 지난 raw/ 와 QA 캡처 삭제

PM 모드(config.mode = "pm"): git이 아닌 작업공간 루트에서 저장소 여러 개(config.repos)를 다룬다.
  codex·gate·verdict 에 --repo NAME 을 주면 그 저장소를 기준으로 동작한다. 개발 역할의 쓰기는 그 저장소 안으로 제한된다.
"""
import argparse
import datetime as dt
import fnmatch
import hashlib
import json
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

KIT = Path(__file__).resolve().parent.parent
DIRS = ["00-request", "01-planning", "02-development", "03-qa", "04-wiki", "raw"]
VERDICTS = ["READY", "APPROVED", "REJECTED", "BLOCKED", "PASSED", "FAILED", "ESCALATED"]
LABEL = {"READY": "READY", "APPROVED": "승인", "REJECTED": "반려", "BLOCKED": "BLOCKED",
         "PASSED": "PASSED", "FAILED": "FAILED", "ESCALATED": "사람 조정 요청"}
REVIEW = {"APPROVED", "REJECTED", "PASSED", "FAILED", "BLOCKED"}
READ_ONLY_ROLES = {"plan-reviewer", "wiki-reviewer", "dev-reviewer"}
# 작업 등급. 가벼움은 스타일·문구·배치만, 보통은 설계가 확정된 동작 조정, 무거움은 기능 추가·삭제·계약·데이터(CROSSGATE.md 10장)
ROUTES = {"light": {"stages": ["request", "dev"], "effort": {"developer": "low", "dev-reviewer": "low"}},
          "standard": {"stages": ["request", "dev"]},
          "full": {"stages": ["request", "plan", "dev", "qa", "wiki"]}}
WRITE_ROLES = {"developer", "qa"}

# ponytail: 정규식 마스킹이라 형식이 특이한 비밀은 놓칠 수 있다. 누락이 나오면 패턴을 늘리거나 gitleaks로 바꾼다.
SECRET = re.compile(
    r"(?i)((?:api[_-]?key|token|secret|password|passwd|authorization)[\"']?\s*[:=]\s*[\"']?(?:bearer\s+)?)([^\s\"',]{6,})"
    r"|\b(sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,})")


def mask(text):
    return SECRET.sub(lambda m: m.group(1) + "***" if m.group(1) else "***", text)


def git(*args, check=True, strip=True, cwd=None):
    # quotepath=false: 한글 경로를 이스케이프하지 않아야 경로 비교가 맞는다
    r = subprocess.run(["git", "-c", "core.quotepath=false", *args], capture_output=True, text=True, cwd=cwd)
    if check and r.returncode:
        sys.exit(f"git {' '.join(args)} 실패: {r.stderr.strip()}")
    return r.stdout.strip() if strip else r.stdout


def root():
    # 설치된 킷(<루트>/.crossgate/kit)은 자기 루트를 안다. git이 아닌 작업공간 루트도 이것으로 찾는다.
    if KIT.parent.name == ".crossgate":
        return KIT.parent.parent
    return Path(git("rev-parse", "--show-toplevel"))


def match(path, patterns):
    # fnmatch의 *는 /도 넘는다. 그래서 "docs/**"는 하위 전체, "*.md"는 모든 깊이의 md에 맞는다.
    return any(fnmatch.fnmatch(path, p) for p in patterns)


MANIFEST = "MANIFEST.sha256"
SKIP = {MANIFEST, ".DS_Store"}


def kit_files(base):
    return sorted(str(p.relative_to(base)) for p in base.rglob("*")
                  if p.is_file() and p.name not in SKIP and "__pycache__" not in p.parts)


def verify_kit(base=KIT):
    """설치된 킷 복사본이 설치 당시 그대로인지. 문제 목록을 돌려준다(빈 목록 = 봉인 유지). 봉인 파일은 install.sh가 쓴다."""
    m = base / MANIFEST
    if not m.exists():
        return [f"{MANIFEST} 없음 (install.sh로 다시 설치하세요)"]
    want = {}
    for line in m.read_text(encoding="utf-8").splitlines():
        if line and not line.startswith("#"):
            digest, name = line.split("  ", 1)
            want[name] = digest
    problems = []
    for name in kit_files(base):
        if name not in want:
            problems.append(f"추가됨: {name}")
        elif hashlib.sha256((base / name).read_bytes()).hexdigest() != want.pop(name):
            problems.append(f"변경됨: {name}")
    problems += [f"삭제됨: {name}" for name in want]
    return problems


def require_sealed():
    problems = verify_kit()
    if problems:
        sys.exit("킷 복사본이 원본과 다릅니다. 프로젝트에서 킷을 고치지 말고 원본에서 고쳐 다시 설치하세요.\n  "
                 + "\n  ".join(problems[:10]))


def cmd_verify(a):
    require_sealed()
    print("킷 봉인 유지: 설치 당시와 같음")


def config():
    p = root() / ".crossgate" / "config.json"
    if not p.exists():
        sys.exit(".crossgate/config.json 이 없습니다. 킷의 install.sh 로 설치하세요.")
    cfg = json.loads(p.read_text(encoding="utf-8"))
    kv = (KIT / "VERSION").read_text().strip() if (KIT / "VERSION").exists() else "?"
    if cfg.get("kit_version") != kv:
        print(f"경고: config kit_version={cfg.get('kit_version')} / 설치된 킷 {kv}", file=sys.stderr)
    return cfg


def route_conf(cfg, route):
    """등급 설정: 기본값 위에 config.routes 를 덮는다. 0.4 이하 설정(required_stages·quick_stages)과 옛 실행의 "quick"도 읽는다."""
    route = "standard" if route == "quick" else route
    r = {**ROUTES[route], **cfg.get("routes", {}).get(route, {})}
    legacy = {"full": "required_stages", "standard": "quick_stages"}.get(route)
    if "routes" not in cfg and legacy in cfg:
        r["stages"] = cfg[legacy]
    return r


def effort_for(cfg, run, role, engine, override=None):
    """추론 강도: --effort > 이번 실행 등급의 effort > 엔진 설정의 역할별 값 > 엔진 기본값."""
    route = json.loads((run / "meta.json").read_text(encoding="utf-8")).get("route", "full")
    e = cfg.get(engine, {})
    return (override or route_conf(cfg, route).get("effort", {}).get(role)
            or e.get("effort", {}).get(role) or e.get("default_effort"))


def is_pm(cfg):
    return cfg.get("mode") == "pm"


def repo_dir(cfg, name):
    """PM 모드에서 --repo 로 고른 저장소 폴더. 이름이 없으면 None."""
    if not name:
        return None
    rc = cfg.get("repos", {}).get(name)
    if rc is None:
        sys.exit(f"config.repos 에 없는 저장소: {name}")
    d = root() / rc.get("path", name)
    if not (d / ".git").exists():
        sys.exit(f"git 저장소가 아닙니다: {d}")
    return d


def current_run(arg=None):
    if arg:
        return Path(arg).resolve()
    p = root() / ".crossgate" / "current-run"
    if not p.exists():
        sys.exit("현재 실행이 없습니다. crossgate init-run 을 먼저 실행하세요.")
    return root() / p.read_text().strip()


def load(run):
    f = run / "verdicts.jsonl"
    if not f.exists():
        return []
    return [json.loads(line) for line in f.read_text(encoding="utf-8").splitlines() if line.strip()]


def reviews(recs, stage):
    return [x for x in recs if x["stage"] == stage and x["verdict"] in REVIEW]


def open_ids(rec):
    return {k for k, v in rec.get("issues", {}).items() if v != "resolved"}


def escalation(recs, stage, cap):
    rv = [x for x in reviews(recs, stage) if x["verdict"] != "BLOCKED"]
    if not rv or rv[-1]["verdict"] in ("APPROVED", "PASSED"):
        return None
    last = rv[-3:]
    if len(last) == 3:
        stuck = set.intersection(*(open_ids(x) for x in last))
        if stuck:
            return f"지적 {', '.join(sorted(stuck))}이(가) 두 번 수정한 뒤에도 남음"
    if len(rv) >= cap:
        return f"검수 {len(rv)}회로 상한({cap}회) 도달"
    return None


def at(x):
    """판정이 묶인 버전: 저장소@커밋. 버전에 묶이지 않은 판정은 '-'."""
    return (x["repo"] + "@" if x.get("repo") else "") + (x.get("commit") or "-")[:7]


def write_timeline(run):
    rows = ["# 판정 타임라인", "", "`crossgate verdict`가 자동 생성한다. 직접 수정하지 않는다.", "",
            "| 시각 | 단계 | 회차 | 판정 | 주체 | 커밋 | 지적 | 비고 |", "|---|---|---|---|---|---|---|---|"]
    for x in load(run):
        issues = ", ".join(f"{k}:{v}" for k, v in x.get("issues", {}).items())
        who = " ".join(filter(None, [x.get("actor"), x.get("model")]))
        note = (x.get("note") or "").replace("|", "/").replace("\n", " ")
        rows.append(f"| {x['ts'][5:16].replace('T', ' ')} | {x['stage']} | {x['attempt']} | {LABEL[x['verdict']]} "
                    f"| {who} | {at(x)} | {issues} | {note} |")
    (run / "timeline.md").write_text("\n".join(rows) + "\n", encoding="utf-8")


def cmd_init_run(a):
    r, now = root(), dt.datetime.now()
    day = r / "ai-log" / now.strftime("%Y%m%d")
    day.mkdir(parents=True, exist_ok=True)
    n = len([d for d in day.iterdir() if d.is_dir()]) + 1
    slug = re.sub(r"[^\w-]+", "-", a.slug).strip("-")
    run = day / f"{n:03d}_{now:%H%M%S}_{slug}"
    for d in DIRS:
        (run / d).mkdir(parents=True)
    shutil.copy(KIT / "templates" / "request.md", run / "00-request" / "request.md")
    meta = {"slug": slug, "route": "standard" if a.quick else a.route,
            "branch": git("rev-parse", "--abbrev-ref", "HEAD", check=False, cwd=r) or None, "created": now.isoformat(timespec="seconds")}
    (run / "meta.json").write_text(json.dumps(meta, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    cur = r / ".crossgate" / "current-run"
    prev = r / cur.read_text().strip() if cur.exists() else None
    if prev and prev.is_dir():
        idle = (time.time() - max(f.stat().st_mtime for f in prev.iterdir() if f.is_file())) / 60
        if idle < RECENT_MIN:
            print(f"주의: 현재 실행 {prev.name}이(가) {idle:.0f}분 전에 쓰였다. 다른 세션이 쓰는 중이면 그 세션의 기록이 "
                  f"이 새 실행으로 섞인다. 모든 명령에 --run 을 붙인다.", file=sys.stderr)
    cur.write_text(str(run.relative_to(r)))
    print(run.relative_to(r))


def cmd_route(a):
    run = current_run(a.run)
    f = run / "meta.json"
    meta = json.loads(f.read_text(encoding="utf-8"))
    order = list(ROUTES)
    old = "standard" if meta["route"] == "quick" else meta["route"]
    if order.index(a.route) <= order.index(old):
        sys.exit(f"등급은 올리기만 한다({old} → {a.route} 불가). 낮추려면 사용자 확인 뒤 새 실행을 만든다.")
    meta["route"] = a.route
    meta.setdefault("promoted", []).append({"from": old, "to": a.route, "ts": dt.datetime.now().isoformat(timespec="seconds")})
    f.write_text(json.dumps(meta, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(f"등급 승격: {old} → {a.route}. 필수 단계: {', '.join(route_conf(config(), a.route)['stages'])}")


def cmd_codex(a):
    cfg, r = config(), root()
    run = current_run(a.run)
    if a.role not in READ_ONLY_ROLES | WRITE_ROLES:
        sys.exit(f"Codex가 맡을 수 없는 역할: {a.role}")
    sandbox = "read-only" if a.role in READ_ONLY_ROLES else "workspace-write"
    repo = repo_dir(cfg, a.repo)
    if is_pm(cfg) and sandbox == "workspace-write" and not repo:
        sys.exit("PM 모드의 개발·QA 역할은 --repo 가 필요합니다(쓰기를 저장소 하나로 제한).")
    if not is_pm(cfg) and sandbox == "workspace-write":
        dirty = [l for l in git("status", "--porcelain", "--", "ai-log", strip=False, cwd=r).splitlines()
                 if l.strip() and "/raw/" not in l and "/03-qa/captures/" not in l and not l.rstrip().endswith("usage.jsonl")]
        if dirty:
            sys.exit("ai-log에 커밋하지 않은 변경이 있습니다. 지시 파일까지 커밋한 뒤 부르고, 그 커밋을 gate --protect-since 에 줍니다"
                     "(아니면 gate가 Master의 파일을 보호 경로 위반으로 잡는다).\n" + "\n".join(dirty[:5]))
    c = cfg.get("codex", {})
    effort = effort_for(cfg, run, a.role, "codex", a.effort) or "high"
    task = Path(a.prompt_file).read_text(encoding="utf-8")
    prompt = "\n\n---\n\n".join([
        (KIT / "roles" / f"{a.role}.md").read_text(encoding="utf-8"),
        (KIT / "CROSSGATE.md").read_text(encoding="utf-8"),
        f"# 이번 작업\n\n실행 기록 폴더: `{run.relative_to(r)}`\n\n{task}"])
    if repo and sandbox == "workspace-write":
        prompt += (f"\n\n---\n\n작업 저장소: `{repo.relative_to(r)}`. 쓰기는 이 저장소 안에서만 된다. "
                   "실행 기록 폴더는 쓸 수 없으니 todo.md 체크 대신 항목별 완료 근거를 답변에 적는다.")
    stamp = dt.datetime.now().strftime("%H%M%S")
    out = run / "raw" / f"{stamp}_{a.role}_reply.md"
    model = c.get("model", "gpt-6-astra")
    cmd = ["codex", "exec", "-m", model, "-c", f"model_reasoning_effort={effort}",
           "-s", sandbox, "-C", str(repo or r), "--skip-git-repo-check", "--json", "-o", str(out), "-"]
    if c.get("ephemeral"):
        cmd.insert(-1, "--ephemeral")
    if sandbox == "workspace-write" and c.get("network"):
        cmd[1:1] = ["-c", "sandbox_workspace_write.network_access=true"]
    started = time.time()
    p = subprocess.run(cmd, input=prompt, text=True, capture_output=True, cwd=r)
    (run / "raw" / f"{stamp}_{a.role}_task.md").write_text(mask(task), encoding="utf-8")
    reply = mask(out.read_text(encoding="utf-8")) if out.exists() else ""
    if out.exists():
        out.write_text(reply, encoding="utf-8")
    usage = sum_usage(p.stdout)
    rec = {"ts": dt.datetime.now().isoformat(timespec="seconds"), "engine": "codex", "role": a.role, "model": model, "effort": effort,
           "seconds": round(time.time() - started), "exit": p.returncode, **usage}
    with open(run / "usage.jsonl", "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    print(reply)
    print(f"\n[codex {a.role} · {sandbox} · {effort} · {rec['seconds']}s · "
          f"in {usage['input_tokens']:,} / out {usage['output_tokens']:,} tok · exit {p.returncode}]", file=sys.stderr)
    if p.returncode:
        print(mask(p.stderr[-2000:]), file=sys.stderr)
        sys.exit(p.returncode)


RECENT_MIN = 60  # ponytail: 활동 여부를 파일 시각으로만 본다. 세션별 실행 지정이 필요해지면 CROSSGATE_RUN 같은 명시적 바인딩으로 바꾼다
TODO_FILE = "ai-log/*/01-planning/todo.md"
USAGE_FILE = "ai-log/*/usage.jsonl"


def appended_only(ref, path):
    """파이프라인 CLI가 쓰는 사용량 기록처럼, 기존 줄은 그대로 두고 줄만 덧붙였는지."""
    diff = git("diff", "-U0", ref, "--", path, strip=False).splitlines()
    body = [l for l in diff if l[:1] in "+-" and not l.startswith(("+++", "---"))]
    return all(l.startswith("+") for l in body)


def todo_checks_only(ref, path):
    """개발 역할이 todo.md에서 체크([ ]→[x])와 '완료 근거:' 줄만 바꿨는지."""
    diff = git("diff", "-U0", ref, "--", path, strip=False).splitlines()
    lines = [l for l in diff if l[:1] in "+-" and not l.startswith(("+++", "---"))]
    minus = [l[1:] for l in lines if l.startswith("-")]
    plus = [l[1:] for l in lines if l.startswith("+")]
    if any(m.replace("- [ ]", "- [x]", 1) not in plus for m in minus):
        return False
    return all(p.replace("- [x]", "- [ ]", 1) in minus or p.strip().startswith("완료 근거:") for p in plus)


USAGE_KEYS = ("input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens")


def sum_usage(jsonl):
    """codex exec --json 출력에서 turn.completed 이벤트의 토큰을 합친다."""
    total = dict.fromkeys(USAGE_KEYS, 0)
    for line in jsonl.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") == "turn.completed":
            for k in USAGE_KEYS:
                total[k] += e.get("usage", {}).get(k) or 0
    return total


CLAUDE_TOOLS = "Read,Grep,Glob"


def cmd_claude(a):
    """Claude 검수를 읽기 도구만 켠 헤드리스 세션으로 돌린다. MCP 서버도 싣지 않는다."""
    cfg, r = config(), root()
    run = current_run(a.run)
    if a.role not in READ_ONLY_ROLES:
        sys.exit(f"crossgate claude는 검수 역할만 맡는다: {sorted(READ_ONLY_ROLES)}")
    model = cfg.get("claude", {}).get("model", "claude-opus-5-5")
    task = Path(a.prompt_file).read_text(encoding="utf-8")
    prompt = "\n\n---\n\n".join([
        (KIT / "roles" / f"{a.role}.md").read_text(encoding="utf-8"),
        (KIT / "CROSSGATE.md").read_text(encoding="utf-8"),
        f"# 이번 작업\n\n실행 기록 폴더: `{run.relative_to(r)}`\n\n{task}"])
    cmd = ["claude", "-p", "--model", model, "--tools", CLAUDE_TOOLS, "--permission-mode", "dontAsk",
           "--strict-mcp-config", "--no-session-persistence", "--output-format", "json"]
    effort = effort_for(cfg, run, a.role, "claude", a.effort)
    if effort:
        cmd += ["--effort", effort]
    started = time.time()
    p = subprocess.run(cmd, input=prompt, text=True, capture_output=True, cwd=r)
    try:
        out = json.loads(p.stdout)
    except ValueError:
        out = {}
    u = out.get("usage", {})
    usage = {"input_tokens": (u.get("input_tokens") or 0) + (u.get("cache_creation_input_tokens") or 0) + (u.get("cache_read_input_tokens") or 0),
             "cached_input_tokens": u.get("cache_read_input_tokens") or 0, "output_tokens": u.get("output_tokens") or 0,
             "reasoning_output_tokens": 0, "cost_usd": out.get("total_cost_usd")}
    rec = {"ts": dt.datetime.now().isoformat(timespec="seconds"), "engine": "claude", "role": a.role, "model": model,
           "effort": effort, "seconds": round(time.time() - started), "exit": p.returncode, **usage}
    with open(run / "usage.jsonl", "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    stamp = dt.datetime.now().strftime("%H%M%S")
    reply = mask(out.get("result") or "")
    (run / "raw" / f"{stamp}_{a.role}_task.md").write_text(mask(task), encoding="utf-8")
    (run / "raw" / f"{stamp}_{a.role}_reply.md").write_text(reply, encoding="utf-8")
    print(reply)
    print(f"\n[claude {a.role} · 읽기 전용({CLAUDE_TOOLS}) · {rec['seconds']}s · in {usage['input_tokens']:,} / "
          f"out {usage['output_tokens']:,} tok · ${usage['cost_usd'] or 0:.2f} · exit {p.returncode}]", file=sys.stderr)
    if p.returncode or not out:
        print(mask(p.stderr[-2000:]), file=sys.stderr)
        sys.exit(p.returncode or 1)


def cmd_gate(a):
    require_sealed()
    cfg, r = config(), root()
    repo = repo_dir(cfg, a.repo)
    if is_pm(cfg) and not repo:
        sys.exit("PM 모드의 gate 는 --repo 가 필요합니다.")
    rc, cwd = (cfg["repos"][a.repo], repo) if repo else (cfg, r)
    failed = []
    if a.protect_since:
        changed = set(git("diff", "--name-only", a.protect_since, cwd=cwd).splitlines())
        changed |= set(git("ls-files", "--others", "--exclude-standard", cwd=cwd).splitlines())
        hit = sorted(f for f in changed if match(f, rc.get("protected", []))
                     and not (match(f, [TODO_FILE]) and todo_checks_only(a.protect_since, f))
                     and not (match(f, [USAGE_FILE]) and appended_only(a.protect_since, f)))
        if hit:
            failed.append("보호 경로 변경: " + ", ".join(hit))
    # 명령은 프로젝트의 config.json에서 온다(package.json 스크립트와 같은 신뢰 수준). config는 보호 경로다.
    for g in rc.get("gate", []):
        print(f"▶ {g['name']}: {g['run']}", flush=True)
        if subprocess.run(g["run"], shell=True, cwd=cwd).returncode:
            failed.append(g["name"])
    if failed:
        sys.exit("gate 실패: " + " / ".join(failed))
    print("gate 통과")


def cmd_verdict(a):
    cfg, run = config(), current_run(a.run)
    recs = load(run)
    repo = repo_dir(cfg, a.repo)
    # PM 모드에서 저장소를 고르지 않은 판정(요청·기획 등)은 코드 버전에 묶지 않는다
    versioned = bool(repo) or not is_pm(cfg)
    if a.verdict in ("APPROVED", "PASSED"):
        if a.unverified:
            sys.exit("미검증 항목이 있으면 승인할 수 없습니다 (R13).")
        dirty = versioned and [line for line in git("status", "--porcelain", strip=False, cwd=repo).splitlines()
                 if line.strip() and not line[3:].strip('"').startswith("ai-log/")]
        if dirty:
            sys.exit("커밋되지 않은 변경이 있습니다. 승인은 커밋된 상태에만 기록합니다.\n" + "\n".join(dirty[:10]))
    submissions = [x for x in recs if x["stage"] == a.stage and x["verdict"] == "READY"]
    attempt = a.attempt or (len(submissions) + (1 if a.verdict == "READY" else 0)) or 1
    issues = dict(kv.split("=", 1) for kv in a.issues.split(",")) if a.issues else {}
    model = a.model
    # 검수 판정의 모델은 그 엔진의 마지막 호출 기록에서 채운다. 손으로 적은 값이 다르면 알린다
    if a.verdict in REVIEW and a.actor in ("claude", "codex") and (run / "usage.jsonl").exists():
        used = [json.loads(l) for l in (run / "usage.jsonl").read_text(encoding="utf-8").splitlines() if l.strip()]
        last = next((u["model"] for u in reversed(used) if u.get("engine", "codex") == a.actor), None)
        if last and not model:
            model = last
        elif last and model != last:
            print(f"주의: --model {model} 이 마지막 {a.actor} 호출의 모델 {last} 과 다르다. 그대로 기록한다.", file=sys.stderr)
    rec = {"ts": dt.datetime.now().isoformat(timespec="seconds"), "stage": a.stage, "attempt": attempt,
           "verdict": a.verdict, "actor": a.actor, "model": model,
           "commit": git("rev-parse", "HEAD", cwd=repo) if versioned else None, "repo": a.repo,
           "issues": issues, "unverified": a.unverified or [], "evidence": a.evidence or [],
           "tokens": a.tokens, "note": a.note}
    with open(run / "verdicts.jsonl", "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    write_timeline(run)
    print(f"기록: {a.stage} #{attempt} {LABEL[a.verdict]} @ {at(rec)} → {run.name}")
    esc = escalation(load(run), a.stage, cfg.get("cap", 3))
    if esc:
        print(f"조정 필요: {esc}. ESCALATED를 기록하고 사용자에게 묻습니다.")


def cmd_status(a):
    run, cap = current_run(a.run), config().get("cap", 3)
    recs = load(run)
    meta = json.loads((run / "meta.json").read_text(encoding="utf-8"))
    print(f"{run.relative_to(root())} · 경로 {meta['route']}")
    uf = run / "usage.jsonl"
    if uf.exists():
        calls = [json.loads(line) for line in uf.read_text(encoding="utf-8").splitlines() if line.strip()]
        for engine in ("codex", "claude"):
            cs = [c for c in calls if c.get("engine", "codex") == engine]
            if cs:
                cost = sum(c.get("cost_usd") or 0 for c in cs)
                print(f"  {engine} 호출 {len(cs)}회 · 입력 {sum(c['input_tokens'] for c in cs):,} · 출력 "
                      f"{sum(c['output_tokens'] for c in cs):,} 토큰 · {sum(c['seconds'] for c in cs)}초"
                      + (f" · ${cost:.2f}" if cost else ""))
    for st in ["request", "plan", "dev", "qa", "wiki"]:
        rv = reviews(recs, st)
        last = rv[-1] if rv else None
        esc = escalation(recs, st, cap)
        state = f"{LABEL[last['verdict']]} @ {at(last)}" if last else "-"
        opened = ", ".join(sorted(open_ids(last))) if last else ""
        print(f"  {st:<8} 검수 {len(rv)}/{cap}  최신 {state}  {('미해결 ' + opened) if opened else ''}"
              f"{('  ⚠ ' + esc) if esc else ''}")


def cmd_merge_check(a):
    require_sealed()
    cfg = config()
    if is_pm(cfg):
        sys.exit("PM 모드에는 merge-check 가 없습니다. 저장소별 병합은 작업공간 규칙(AGENTS.md 등)을 따릅니다.")
    base = git("merge-base", a.base, "HEAD")
    changed = git("diff", "--name-only", base, "HEAD").splitlines()
    runs = sorted({"/".join(f.split("/")[:3]) for f in changed if f.startswith("ai-log/") and f.count("/") >= 3})
    if len(runs) != 1:
        sys.exit(f"✗ 이 변경에 연결된 실행 기록이 {len(runs)}개입니다. 1개여야 합니다: {runs}")
    run = root() / runs[0]
    recs = load(run)
    meta = json.loads((run / "meta.json").read_text(encoding="utf-8"))
    stages = route_conf(cfg, meta["route"])["stages"]
    problems = []
    hit = [f for f in changed if not f.startswith("ai-log/") and match(f, cfg.get("forbidden", []))]
    if hit:
        problems.append("금지 경로 변경: " + ", ".join(hit))
    if any(x["verdict"] == "ESCALATED" for x in recs):
        problems.append("사람 조정 요청(ESCALATED) 기록이 있음")
    for st in stages:
        rv = reviews(recs, st)
        want = "PASSED" if st == "qa" else "APPROVED"
        if not rv or rv[-1]["verdict"] != want:
            problems.append(f"{st}: 최종 판정이 {LABEL[want]}이 아님 ({LABEL[rv[-1]['verdict']] if rv else '없음'})")
            continue
        if rv[-1].get("unverified"):
            problems.append(f"{st}: 미검증 항목 {rv[-1]['unverified']}")
        # ponytail: request·plan은 버전 대조를 하지 않는다. 기획 문서가 승인 뒤 바뀌는 사고가 나오면 대조 대상에 넣는다.
        if st in ("dev", "qa", "wiki"):
            skip = ["ai-log/*"] + (cfg.get("doc_paths", []) if st != "wiki" else [])
            moved = [f for f in git("diff", "--name-only", rv[-1]["commit"], "HEAD").splitlines() if not match(f, skip)]
            if moved:
                problems.append(f"{st} 승인 뒤 바뀐 파일: " + ", ".join(moved[:10]))
    if problems:
        print(f"✗ 자동 병합 불가 ({runs[0]})")
        for p in problems:
            print(f"  - {p}")
        sys.exit(1)
    print(f"✓ 자동 병합 조건 충족 ({runs[0]}, 단계 {', '.join(stages)})")


def cmd_deploy(a):
    d = config().get("deploy") or sys.exit("config.deploy 가 없습니다.")
    subprocess.run(d["preview"], shell=True, cwd=root())
    if not a.yes:
        print("\n위 변경이 배포됩니다. 사용자 지시를 받은 뒤 --yes 로 실행합니다.")
        return
    sys.exit(subprocess.run(d["command"], shell=True, cwd=root()).returncode)


def cmd_clean_raw(a):
    days = a.days or config().get("raw_retention_days", 30)
    cutoff = time.time() - days * 86400
    for run in (root() / "ai-log").glob("*/*/"):
        for sub in ("raw", "03-qa/captures"):
            d = run / sub
            if d.is_dir() and d.stat().st_mtime < cutoff:
                shutil.rmtree(d)
                print(f"삭제: {d.relative_to(root())}")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="crossgate", description=__doc__.split("\n")[0])
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("init-run"); p.add_argument("slug"); p.add_argument("--route", choices=list(ROUTES), default="full")
    p.add_argument("--quick", action="store_true", help="0.4 이하 호환: --route standard")
    p.set_defaults(fn=cmd_init_run)
    p = sp.add_parser("codex"); p.add_argument("role"); p.add_argument("--prompt-file", required=True)
    p.add_argument("--run"); p.add_argument("--repo"); p.add_argument("--effort"); p.set_defaults(fn=cmd_codex)
    p = sp.add_parser("claude"); p.add_argument("role"); p.add_argument("--prompt-file", required=True)
    p.add_argument("--run"); p.add_argument("--effort"); p.set_defaults(fn=cmd_claude)
    p = sp.add_parser("route"); p.add_argument("route", choices=list(ROUTES)); p.add_argument("--run")
    p.set_defaults(fn=cmd_route)
    p = sp.add_parser("verify"); p.set_defaults(fn=cmd_verify)
    p = sp.add_parser("gate"); p.add_argument("--protect-since"); p.add_argument("--repo"); p.set_defaults(fn=cmd_gate)
    p = sp.add_parser("verdict")
    p.add_argument("--stage", required=True, choices=["request", "plan", "dev", "qa", "wiki"])
    p.add_argument("--verdict", required=True, choices=VERDICTS)
    p.add_argument("--attempt", type=int); p.add_argument("--actor"); p.add_argument("--model")
    p.add_argument("--issues", help="P-1=open,P-2=resolved"); p.add_argument("--unverified", nargs="*")
    p.add_argument("--evidence", nargs="*"); p.add_argument("--tokens", type=int); p.add_argument("--note")
    p.add_argument("--run"); p.add_argument("--repo"); p.set_defaults(fn=cmd_verdict)
    p = sp.add_parser("status"); p.add_argument("--run"); p.set_defaults(fn=cmd_status)
    p = sp.add_parser("merge-check"); p.add_argument("--base", required=True); p.set_defaults(fn=cmd_merge_check)
    p = sp.add_parser("deploy"); p.add_argument("--yes", action="store_true"); p.set_defaults(fn=cmd_deploy)
    p = sp.add_parser("clean-raw"); p.add_argument("--days", type=int); p.set_defaults(fn=cmd_clean_raw)
    a = ap.parse_args(argv)
    a.fn(a)


if __name__ == "__main__":
    main()
