#!/usr/bin/env python3
"""Crossgate — AI 교차검수 파이프라인 CLI. 표준 라이브러리만 사용한다 (Python 3.9+)."""
import sys
sys.dont_write_bytecode = True

import argparse
import importlib
import pkgutil
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from cg import commands


def main(argv=None):
    ap = argparse.ArgumentParser(prog="crossgate", description=__doc__)
    sp = ap.add_subparsers(dest="cmd", required=True)
    for module in sorted(pkgutil.iter_modules(commands.__path__), key=lambda item: item.name):
        importlib.import_module(f"cg.commands.{module.name}").register(sp)
    # 모듈은 이름순으로 읽되 기존 도움말의 명령 순서는 유지한다.
    ordered = sorted(sp.choices.items(), key=lambda item: getattr(item[1], "_crossgate_order", float("inf")))
    sp.choices.clear()
    sp.choices.update(ordered)
    a = ap.parse_args(argv)
    a.fn(a)


if __name__ == "__main__":
    main()
