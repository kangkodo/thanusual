{
  "kit_version": "0.1.1",
  "codex": {
    "model": "gpt-6-astra",
    "default_effort": "high",
    "effort": { "plan-reviewer": "xhigh", "wiki-reviewer": "high", "developer": "high", "qa": "high" },
    "network": false
  },
  "pairing": { "developer": "codex", "reviewer": "claude" },
  "cap": 3,
  "gate": [
    { "name": "test", "run": "npm test" },
    { "name": "acceptance", "run": "sh -c 'set -- tests/acceptance/*.test.js; [ -e \"$1\" ] || exit 0; node --test \"$@\"'" }
  ],
  "protected": [".pipeline/*", "ai-log/*", "tests/acceptance/*"],
  "forbidden": [
    ".github/workflows/*", "wrangler.toml", "_headers", "package.json",
    "functions/*", "lib/tiles.js",
    "scripts/poll.sh", "scripts/poller.py", "scripts/collect*.py", "scripts/baseline.py",
    "scripts/seoul_api.py", "scripts/timeline.py",
    ".dev.vars", "*.env", "secrets/*", "*.key"
  ],
  "doc_paths": ["docs/*", "*.md"],
  "required_stages": ["request", "plan", "dev", "qa", "wiki"],
  "quick_stages": ["request", "dev", "qa"],
  "qa": {
    "runner": "codex",
    "acceptance": "tests/acceptance",
    "serve": "npx wrangler pages dev . --port 8788",
    "url": "http://localhost:8788"
  },
  "deploy": {
    "preview": "git fetch -q origin && git log --oneline origin/release..origin/main",
    "command": "git push origin origin/main:refs/heads/release"
  },
  "raw_retention_days": 30
}
